{
    "name": "ds_adls_binary",
    "type": "Microsoft.Synapse/workspaces/datasets",
    "properties": {
        "description": "Any file in ADLS, addressed by container/folder/file. Generated by tools/build_synapse.py.",
        "linkedServiceName": {
            "referenceName": "ls_adls",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "container": {
                "type": "string"
            },
            "folder": {
                "type": "string",
                "defaultValue": ""
            },
            "file": {
                "type": "string"
            }
        },
        "annotations": [
            "copilot-generated"
        ],
        "type": "Binary",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileName": {
                    "value": "@dataset().file",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@dataset().folder",
                    "type": "Expression"
                },
                "fileSystem": {
                    "value": "@dataset().container",
                    "type": "Expression"
                }
            }
        }
    }
}
